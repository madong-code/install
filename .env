# 应用标题
VITE_APP_TITLE=MD-Admin 安装向导

# 应用命名空间
VITE_APP_NAMESPACE=madong-install

# 版本模式（三态）：
#  - standard：强制标准版（5 步，无部署模式等多租户参数），运行时接口不可翻转
#  - saas：强制多租户版（6 步，含部署模式步骤），按前端 env 锁定，接口异常不回退
#  - auto（或未配置）：自动识别——由后端框架验证接口 /install/framework 判断，
#    验证通过进入 saas，验证失败/接口异常/无响应时自动回退 standard（无感知）
VITE_APP_EDITION=auto

# SaaS 场景下「部署模式」步骤的默认选中值：true（多租户）或 false（单体部署）
# 标准版下该变量不生效
VITE_ENABLE_TENANT=true

# 是否启用离线图标
VITE_APP_ICON_OFFLINE=false
