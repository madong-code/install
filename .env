# 应用标题
VITE_APP_TITLE=MD-Admin 安装向导

# 应用命名空间
VITE_APP_NAMESPACE=madong-install

# 当前场景（版本）：standard（madong 标准版）或 saas（madong-saas 多租户版）
# 优先级：后端检测接口 /install/edition > 本环境变量 > 默认 standard
# standard 为 5 步安装流程；saas 为 6 步，额外包含「部署模式」步骤
VITE_APP_EDITION=standard

# SaaS 场景下「部署模式」步骤的默认选中值：true（多租户）或 false（单体部署）
# 标准版下该变量不生效
VITE_ENABLE_TENANT=true

# 是否启用离线图标
VITE_APP_ICON_OFFLINE=false
